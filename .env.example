BUYBOX_MCP_ENV=development
BUYBOX_MCP_HOST=0.0.0.0
BUYBOX_MCP_PORT=8000
BUYBOX_MCP_LOG_LEVEL=INFO
BUYBOX_MCP_BEARER_TOKEN=replace-with-a-long-random-token
BUYBOX_MCP_MONGO_URI=mongodb://localhost:27017
BUYBOX_MCP_MONGO_DATABASE=bb2
# Optional, comma-separated for browser clients:
# BUYBOX_MCP_CORS_ALLOWED_ORIGINS=https://example.com,https://app.example.com
FEDEX_API_KEY=
FEDEX_API_SECRET=
FEDEX_ACCOUNT_NUMBER=
# Defaults to sandbox; set to https://apis.fedex.com for production:
# FEDEX_API_BASE=https://apis-sandbox.fedex.com